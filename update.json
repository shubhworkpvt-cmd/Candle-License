{"version":2,"notes":"Test update (only the version number changes)","required":false,"html":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#0d1b1e\">\n<title>Candle Call</title>\n<script>var APP_VER=2,NATIVE_VER=5;\n(function(){try{var v=+localStorage.getItem('cc_ver')||0,h=localStorage.getItem('cc_upd'),t=+localStorage.getItem('cc_try')||0;\nif(v>APP_VER&&h){if(t>=3){localStorage.removeItem('cc_upd');localStorage.removeItem('cc_ver');localStorage.removeItem('cc_try');return}\nlocalStorage.setItem('cc_try',t+1);document.open();document.write(h);document.close()}}catch(e){}})();</script>\n<style>\n:root{--bg:#0d1b1e;--panel:#14272b;--line:#23393e;--tx:#e9f0ec;--mu:#8ca3a6;--up:#41d9a0;--dn:#ff6f61;--am:#f2c14e}\n*{box-sizing:border-box}\nhtml,body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-variant-numeric:tabular-nums}\nbody{padding:max(12px,env(safe-area-inset-top)) 14px max(20px,env(safe-area-inset-bottom));max-width:560px;margin:0 auto}\n.bar{display:flex;gap:8px;margin-bottom:12px}\nselect{flex:1;background:var(--panel);color:var(--tx);border:1px solid var(--line);border-radius:10px;padding:11px 10px;font-size:15px}\n.cust{display:flex;gap:8px;margin-bottom:12px}\ninput{flex:1;min-width:0;background:var(--panel);color:var(--tx);border:1px solid var(--line);border-radius:10px;padding:11px 10px;font-size:14px}\nbutton{background:var(--up);color:#07231a;border:0;border-radius:10px;padding:0 16px;font-weight:700;font-size:14px}\n#lic{font-size:12px;color:var(--am);margin:0 2px 6px;min-height:0}\n#lock .verdict{margin-top:48px}\n#lock input{width:100%;margin-top:14px}\n#lock button{width:100%;padding:13px;margin-top:12px}\n.verdict{border-radius:16px;padding:18px 18px 16px;background:var(--panel);border:1px solid var(--line);margin-bottom:12px}\n.verdict .big{font-size:44px;font-weight:800;letter-spacing:-1px;line-height:1}\n.verdict .sub{color:var(--mu);margin-top:8px;font-size:14px}\n.up{color:var(--up)}.dn{color:var(--dn)}.nu{color:var(--am)}\n.row{display:flex;justify-content:space-between;align-items:baseline;gap:10px}\n.price{font-size:22px;font-weight:700}\n.meter{height:8px;border-radius:4px;background:var(--dn);margin-top:14px;position:relative;overflow:hidden}\n.meter i{position:absolute;left:0;top:0;bottom:0;background:var(--up)}\n.o{background:transparent;color:var(--mu);border:1px solid var(--line);padding:8px 12px;font-weight:600}\n.pl{display:flex;gap:8px;padding:8px 0}.pl button{flex:1;margin:0;padding:12px}\ncanvas{width:100%;height:230px;display:block;background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-bottom:12px}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:6px 14px;margin-bottom:12px}\n.card .r{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--line);font-size:14px}\n.card .r:last-child{border:0}\n.card .r span:first-child{color:var(--mu)}\nh2{font-size:14px;font-weight:600;margin:16px 2px 8px;color:var(--mu)}\n.dots{display:flex;gap:4px;flex-wrap:wrap;padding:12px 14px}\n.dots b{width:14px;height:14px;border-radius:4px;background:var(--dn)}\n.dots b.ok{background:var(--up)}\n.note{color:var(--mu);font-size:12px;line-height:1.5;margin-top:14px}\n#st{color:var(--mu);font-size:12px;margin:0 2px 10px}\n</style>\n</head>\n<body>\n<div id=\"lock\" style=\"display:none\"><div class=\"verdict\">\n  <div class=\"big nu\" style=\"font-size:30px\">Candle Call</div>\n  <div class=\"sub\" id=\"lmsg\" style=\"color:var(--am);min-height:20px;margin-top:10px\"></div>\n  <input id=\"lurl\" placeholder=\"Licence server URL (one-time setup)\" style=\"display:none\" autocomplete=\"off\">\n  <input id=\"lkey\" placeholder=\"Enter your access key\" autocapitalize=\"characters\" autocomplete=\"off\">\n  <button id=\"act\">Unlock</button>\n  <div class=\"sub\" style=\"margin-top:14px\">Device ID: <b id=\"dev\"></b></div>\n</div></div>\n<div id=\"app\" style=\"display:none\">\n<div id=\"upd\" class=\"card\" style=\"display:none;border-color:var(--am)\"><div class=\"r\" style=\"border:0;align-items:center\"><span id=\"updt\"></span><button id=\"updb\" style=\"margin:0;padding:8px 12px\"></button></div></div>\n<div class=\"bar\">\n  <select id=\"sym\"></select>\n  <select id=\"iv\"><option value=\"1m\">1 min</option><option value=\"5m\">5 min</option><option value=\"15m\">15 min</option><option value=\"1h\">1 hour</option></select>\n</div>\n<div class=\"cust\"><input id=\"cust\" placeholder=\"Any Yahoo ticker, e.g. ZOMATO.NS, GC=F\" autocapitalize=\"characters\" autocomplete=\"off\"><button id=\"go\">Go</button></div>\n<div id=\"lic\"></div>\n<div id=\"st\">Loading…</div>\n<div class=\"verdict\">\n  <div class=\"row\"><div class=\"price\" id=\"px\">–</div><div id=\"cd\" style=\"color:var(--mu);font-size:14px\">–</div></div>\n  <div class=\"big nu\" id=\"call\" style=\"margin-top:12px\">…</div>\n  <div class=\"sub\" id=\"why\">Next candle direction</div>\n  <div class=\"meter\"><i id=\"mt\" style=\"width:50%\"></i></div>\n  <div class=\"row\" style=\"font-size:12px;color:var(--mu);margin-top:6px\"><span>Down</span><span>Up</span></div>\n</div>\n<canvas id=\"cv\"></canvas>\n<h2>Demo trading account (virtual money)</h2>\n<div class=\"card\" id=\"pt\">\n  <div class=\"r\"><span>Virtual equity</span><b id=\"ptEq\">–</b></div>\n  <div class=\"r\"><span>Open position</span><b id=\"ptPos\">–</b></div>\n  <div class=\"r\"><span>Trade size</span><select id=\"ptPct\" style=\"flex:none;width:auto;padding:6px 8px\"><option value=\"10\">10%</option><option value=\"25\">25%</option><option value=\"50\">50%</option><option value=\"100\">100%</option></select></div>\n  <div class=\"pl\"><button id=\"bBuy\" style=\"background:var(--up)\">Buy</button><button id=\"bSell\" style=\"background:var(--dn);color:#fff\">Sell</button><button id=\"bClose\" style=\"background:var(--line);color:var(--tx)\">Close</button></div>\n  <div class=\"r\"><span>Auto-trade the model’s calls</span><input type=\"checkbox\" id=\"ptAuto\" style=\"flex:none;width:22px;height:22px;padding:0\"></div>\n  <div class=\"r\"><span>Trades · win rate · net P&amp;L</span><b id=\"ptStat\">–</b></div>\n  <div id=\"ptHist\"></div>\n  <div style=\"padding:10px 0 4px\"><button class=\"o\" id=\"ptReset\" style=\"margin:0\">Reset demo account</button></div>\n</div>\n<h2>Indicators on the last closed candle</h2>\n<div class=\"card\" id=\"ind\"></div>\n<h2>How accurate is it?</h2>\n<div class=\"card\">\n  <div class=\"r\"><span>Backtest accuracy (unseen candles)</span><b id=\"acc\">–</b></div>\n  <div class=\"r\"><span>Always guessing “up” would score</span><b id=\"base\">–</b></div>\n  <div class=\"r\"><span>When the model is confident</span><b id=\"cacc\">–</b></div>\n  <div class=\"r\"><span>Candles it learned from</span><b id=\"ntr\">–</b></div>\n  <div class=\"r\"><span>Live hit rate since you opened this</span><b id=\"live\">–</b></div>\n</div>\n<div class=\"card dots\" id=\"dots\"></div>\n<p class=\"note\">Crypto prices stream live from Binance. Forex and Indian stock data come from Yahoo Finance, refresh every few seconds and can be delayed (up to about 15 minutes for NSE stocks); they load inside the Android app but not in a normal browser tab. A small model is trained on the last 1,000 candles in your browser, retrained after every candle, and tested on candles it has not seen. Short-term price moves are close to random, so expect accuracy near 50–55% at best. This is not financial advice; do not trade money you cannot afford to lose on this signal alone.</p>\n<p class=\"note\" id=\"ver\"></p>\n</div>\n<script>\nconst $=id=>document.getElementById(id);\nconst IVMS={'1m':6e4,'5m':3e5,'15m':9e5,'1h':36e5};\nconst HOSTS=['https://api.binance.com','https://data-api.binance.vision'];\nlet sym='BTCUSDT',iv='1m',K=[],cur=null,model=null,stats={},pred=null,hist=[],ws=null,pollT=null,tok=0,ind=[];\n\nfunction sig(z){return 1/(1+Math.exp(-z))}\nfunction ema(a,n){const k=2/(n+1),o=[a[0]];for(let i=1;i<a.length;i++)o.push(a[i]*k+o[i-1]*(1-k));return o}\nfunction rsi(c,n=14){const o=Array(c.length).fill(50);let g=0,l=0;for(let i=1;i<c.length;i++){const d=c[i]-c[i-1],G=Math.max(d,0),L=Math.max(-d,0);if(i<=n){g+=G;l+=L;if(i===n){g/=n;l/=n;o[i]=100-100/(1+g/(l||1e-9))}}else{g=(g*(n-1)+G)/n;l=(l*(n-1)+L)/n;o[i]=100-100/(1+g/(l||1e-9))}}return o}\n\nconst MAXK=6000;let sinceTrain=0;\nfunction dot(a,b){let s=0;for(let i=0;i<a.length;i++)s+=a[i]*b[i];return s}\nfunction rng(seed){let s=seed>>>0||1;return()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296}}\nfunction build(cs){\n  const c=cs.map(x=>x.c),v=cs.map(x=>x.v),e9=ema(c,9),e21=ema(c,21),e12=ema(c,12),e26=ema(c,26);\n  const m=e12.map((x,i)=>x-e26[i]),s=ema(m,9),r=rsi(c),r7=rsi(c,7);\n  const tr=cs.map((x,i)=>i?Math.max(x.h-x.l,Math.abs(x.h-c[i-1]),Math.abs(x.l-c[i-1])):x.h-x.l),a14=ema(tr,14),a50=ema(tr,50);\n  return cs.map((x,i)=>{\n    if(i<50)return null;\n    const w=c.slice(i-19,i+1),mu=w.reduce((a,b)=>a+b)/20,sd=Math.sqrt(w.reduce((a,b)=>a+(b-mu)**2,0)/20)||1e-9;\n    const win=cs.slice(i-13,i+1),hh=Math.max(...win.map(z=>z.h)),ll=Math.min(...win.map(z=>z.l));\n    const vm=v.slice(i-19,i+1).reduce((a,b)=>a+b)/20||1e-9,rg=(x.h-x.l)||1e-9,d=new Date(x.t),hr=(d.getUTCHours()+d.getUTCMinutes()/60)/24*2*Math.PI;\n    return [(r[i]-50)/50,(m[i]-s[i])/c[i]*1e3,(e9[i]-e21[i])/c[i]*100,(c[i]-mu)/(2*sd),(c[i]-ll)/((hh-ll)||1e-9)-.5,(c[i]/c[i-3]-1)*100,(c[i]/c[i-1]-1)*100,Math.min(v[i]/vm,4)-1,(x.c-x.o)/rg,(c[i]/c[i-10]-1)*100,\n      (x.h-Math.max(x.o,x.c))/rg,(Math.min(x.o,x.c)-x.l)/rg,a14[i]/(a50[i]||1e-9)-1,Math.sin(hr),Math.cos(hr),(c[i]/c[i-2]-1)*100,(r7[i]-50)/50];\n  });\n}\nfunction fit(xs,ys){\n  const d=xs[0].length,n=xs.length,mu=Array(d).fill(0),sd=Array(d).fill(0);\n  xs.forEach(x=>x.forEach((a,j)=>mu[j]+=a/n));\n  xs.forEach(x=>x.forEach((a,j)=>sd[j]+=(a-mu[j])**2/n));\n  sd.forEach((a,j)=>sd[j]=Math.sqrt(a)||1);\n  const Z=xs.map(x=>x.map((a,j)=>Math.max(-5,Math.min(5,(a-mu[j])/sd[j]))));\n  const w=Array(d).fill(0);let b=0;\n  for(let ep=0;ep<200;ep++){\n    const gw=Array(d).fill(0);let gb=0;\n    Z.forEach((x,i)=>{const p=sig(b+dot(x,w))-ys[i];gb+=p;for(let j=0;j<d;j++)gw[j]+=p*x[j]});\n    for(let j=0;j<d;j++)w[j]-=.1*(gw[j]/n+.05*w[j]);\n    b-=.1*gb/n;\n  }\n  const H=12,R=rng(7),W1=[],B1=Array(H).fill(0),W2=Array(H).fill(0).map(()=>(R()-.5)*.4);let B2=0;\n  for(let h=0;h<H;h++)W1.push(Array(d).fill(0).map(()=>(R()-.5)*.6));\n  const idx=Z.map((_,i)=>i);\n  for(let ep=0;ep<25;ep++){\n    for(let i=n-1;i>0;i--){const k=Math.floor(R()*(i+1)),t=idx[i];idx[i]=idx[k];idx[k]=t}\n    for(const i of idx){\n      const x=Z[i],a=W1.map((wr,h)=>Math.tanh(B1[h]+dot(x,wr))),g=sig(B2+dot(a,W2))-ys[i],lr=.01;\n      for(let h=0;h<H;h++){const gh=g*W2[h]*(1-a[h]*a[h]);W2[h]-=lr*(g*a[h]+.001*W2[h]);B1[h]-=lr*gh;for(let j=0;j<d;j++)W1[h][j]-=lr*(gh*x[j]+.001*W1[h][j])}\n      B2-=lr*g;\n    }\n  }\n  return{mu,sd,w,b,W1,B1,W2,B2};\n}\nfunction pr(m,x){\n  const z=x.map((a,j)=>Math.max(-5,Math.min(5,(a-m.mu[j])/m.sd[j])));\n  const a=m.W1.map((wr,h)=>Math.tanh(m.B1[h]+dot(z,wr)));\n  return(sig(m.b+dot(z,m.w))+sig(m.B2+dot(a,m.W2)))/2;\n}\nfunction train(){\n  const F=build(K),X=[],Y=[];\n  for(let i=50;i<K.length-1;i++){X.push(F[i]);Y.push(K[i+1].c>K[i].c?1:0)}\n  if(X.length<150){model=null;return}\n  const cut=Math.floor(X.length*.7),m1=fit(X.slice(0,cut),Y.slice(0,cut));\n  let hit=0,ups=0,ch=0,cn=0;const nt=X.length-cut;\n  for(let i=cut;i<X.length;i++){const p=pr(m1,X[i]),ok=(p>.5?1:0)===Y[i];if(ok)hit++;ups+=Y[i];if(Math.abs(p-.5)>=.04){cn++;if(ok)ch++}}\n  stats={acc:hit/nt,base:Math.max(ups,nt-ups)/nt,n:nt,cAcc:cn?ch/cn:null,cN:cn,total:X.length};\n  model=fit(X,Y);sinceTrain=0;\n}\nfunction predict(){\n  if(!model||!cur)return;\n  const F=build(K.slice(-300)),x=F[F.length-1],p=pr(model,x);\n  pred={t:cur.t,p,up:p>.5};\n  ind=[\n    ['RSI (14)',(x[0]*50+50).toFixed(0),x[0]>.2?'Strong, may be stretched':x[0]<-.2?'Weak, may be oversold':'Neutral',x[0]>.2?-1:x[0]<-.2?1:0],\n    ['MACD momentum',x[1].toFixed(2),x[1]>0?'Rising':'Falling',x[1]>0?1:-1],\n    ['EMA 9 vs 21',x[2].toFixed(3)+'%',x[2]>0?'Short trend above long':'Short trend below long',x[2]>0?1:-1],\n    ['Bollinger position',(x[3]*100).toFixed(0)+'%',x[3]>.8?'Near upper band':x[3]<-.8?'Near lower band':'Mid-band',x[3]>.8?-1:x[3]<-.8?1:0],\n    ['Stochastic',((x[4]+.5)*100).toFixed(0),x[4]>.3?'High in range':x[4]<-.3?'Low in range':'Mid range',x[4]>.3?-1:x[4]<-.3?1:0],\n    ['Volume vs average',((x[7]+1)).toFixed(2)+'x',x[7]>.3?'Busy':'Normal or quiet',0]\n  ];\n}\nconst YI={'1m':'1m','5m':'5m','15m':'15m','1h':'60m'},RG={'1m':'7d','5m':'60d','15m':'60d','1h':'2y'};\nconst GROUPS=[\n['Crypto · Binance live',[['BTCUSDT','Bitcoin'],['ETHUSDT','Ethereum'],['SOLUSDT','Solana'],['BNBUSDT','BNB'],['XRPUSDT','XRP'],['DOGEUSDT','Dogecoin'],['ADAUSDT','Cardano'],['AVAXUSDT','Avalanche'],['LINKUSDT','Chainlink'],['LTCUSDT','Litecoin'],['TRXUSDT','TRON'],['DOTUSDT','Polkadot']]],\n['Forex pairs',[['USDINR=X','USD/INR'],['EURINR=X','EUR/INR'],['GBPINR=X','GBP/INR'],['JPYINR=X','JPY/INR'],['EURUSD=X','EUR/USD'],['GBPUSD=X','GBP/USD'],['USDJPY=X','USD/JPY'],['AUDUSD=X','AUD/USD'],['USDCAD=X','USD/CAD'],['USDCHF=X','USD/CHF'],['NZDUSD=X','NZD/USD'],['EURGBP=X','EUR/GBP'],['EURJPY=X','EUR/JPY'],['GBPJPY=X','GBP/JPY']]],\n['Indian indices',[['^NSEI','NIFTY 50'],['^NSEBANK','BANK NIFTY'],['^BSESN','SENSEX']]],\n['Indian companies · NSE',[['RELIANCE.NS','Reliance Industries'],['TCS.NS','TCS'],['HDFCBANK.NS','HDFC Bank'],['INFY.NS','Infosys'],['ICICIBANK.NS','ICICI Bank'],['SBIN.NS','State Bank of India'],['BHARTIARTL.NS','Bharti Airtel'],['ITC.NS','ITC'],['LT.NS','Larsen & Toubro'],['HINDUNILVR.NS','Hindustan Unilever'],['KOTAKBANK.NS','Kotak Bank'],['AXISBANK.NS','Axis Bank'],['WIPRO.NS','Wipro'],['HCLTECH.NS','HCL Tech'],['TATASTEEL.NS','Tata Steel'],['MARUTI.NS','Maruti Suzuki'],['SUNPHARMA.NS','Sun Pharma'],['BAJFINANCE.NS','Bajaj Finance'],['ASIANPAINT.NS','Asian Paints'],['TITAN.NS','Titan'],['ONGC.NS','ONGC'],['NTPC.NS','NTPC'],['COALINDIA.NS','Coal India'],['ADANIENT.NS','Adani Enterprises']]]\n];\nconst NAMES={};\n$('sym').innerHTML=GROUPS.map(g=>'<optgroup label=\"'+g[0]+'\">'+g[1].map(p=>{NAMES[p[0]]=p[1];return '<option value=\"'+p[0]+'\">'+p[1]+'</option>'}).join('')+'</optgroup>').join('');\nfunction kindOf(s){return /USDT$/.test(s)?'b':'y'}\nfunction isClosed(){return !!cur&&kindOf(sym)==='y'&&Date.now()>cur.ct+IVMS[iv]*2}\nasync function bRows(){\n  let all=[],end=null;\n  for(let p=0;p<6;p++){\n    let rows=null;\n    for(const h of HOSTS){try{const r=await fetch(h+'/api/v3/klines?symbol='+sym+'&interval='+iv+'&limit=1000'+(end?'&endTime='+end:''));if(r.ok){rows=await r.json();break}}catch(e){}}\n    if(!rows||!rows.length)break;\n    all=rows.map(x=>({t:x[0],o:+x[1],h:+x[2],l:+x[3],c:+x[4],v:+x[5],ct:x[6]})).concat(all);\n    end=rows[0][0]-1;if(rows.length<1000)break;\n  }\n  return all.length?all:null;\n}\nasync function yRows(s,range){\n  for(const h of ['query1','query2']){\n    try{\n      const r=await fetch('https://'+h+'.finance.yahoo.com/v8/finance/chart/'+encodeURIComponent(s)+'?interval='+YI[iv]+'&range='+range);\n      if(!r.ok)continue;\n      const j=await r.json(),R=j.chart&&j.chart.result&&j.chart.result[0];if(!R||!R.timestamp)continue;\n      const q=R.indicators.quote[0],out=[];\n      R.timestamp.forEach((t,k)=>{if(q.close[k]==null||q.open[k]==null||q.high[k]==null||q.low[k]==null)return;out.push({t:t*1000,o:q.open[k],h:q.high[k],l:q.low[k],c:q.close[k],v:q.volume&&q.volume[k]||0,ct:t*1000+IVMS[iv]-1})});\n      if(out.length)return out;\n    }catch(e){}\n  }\n  return null;\n}\nfunction stop(){\n  if(ws){ws.onclose=null;try{ws.close()}catch(e){}ws=null}\n  clearInterval(pollT);pollT=null;\n}\nasync function load(){\n  tok++;const my=tok;stop();\n  K=[];cur=null;model=null;pred=null;hist=[];\n  $('st').textContent='Loading '+(NAMES[sym]||sym)+'…';$('call').textContent='…';$('call').className='big nu';\n  let rows=kindOf(sym)==='b'?await bRows():await yRows(sym,RG[iv]);\n  if(my!==tok)return;\n  if(!rows||rows.length<60){$('st').textContent=rows?'Not enough candle history for '+sym+'.':'Could not load '+sym+'. Check the ticker, your connection, or turn off your VPN.';$('call').textContent='No data';return}\n  if(rows.length>MAXK+1)rows=rows.slice(-(MAXK+1));\n  cur=rows.pop();K=rows;$('st').textContent='Training on '+K.length+' candles…';await new Promise(r=>setTimeout(r,30));if(my!==tok)return;train();predict();render();\n  if(kindOf(sym)==='b')connect(my);\n  else{setStatus();pollT=setInterval(()=>poll(my),8000)}\n}\nfunction setStatus(){$('st').textContent=(isClosed()?'Market closed · ':'Live, refreshing every 8s · ')+(NAMES[sym]||sym)+' · '+iv}\nfunction connect(my){\n  ws=new WebSocket('wss://stream.binance.com:9443/ws/'+sym.toLowerCase()+'@kline_'+iv);\n  ws.onopen=()=>$('st').textContent='Live · '+(NAMES[sym]||sym)+' · '+iv;\n  ws.onmessage=e=>{\n    const k=JSON.parse(e.data).k;\n    const c={t:k.t,o:+k.o,h:+k.h,l:+k.l,c:+k.c,v:+k.v,ct:k.T};\n    if(k.x)onClose(c);else{cur=c;live()}\n  };\n  ws.onclose=()=>{if(my===tok){$('st').textContent='Connection lost. Reconnecting…';setTimeout(()=>{if(my===tok)connect(my)},3000)}};\n}\nfunction pushClosed(c){\n  if(pred&&pred.t===c.t){hist.unshift({up:pred.up,ok:pred.up===(c.c>K[K.length-1].c)});if(hist.length>40)hist.pop()}\n  K.push(c);if(K.length>MAXK)K.shift();\n}\nfunction onClose(c){\n  pushClosed(c);\n  cur={t:c.ct+1,o:c.c,h:c.c,l:c.c,c:c.c,v:0,ct:c.ct+IVMS[iv]};\n  if(++sinceTrain>=5||!model)train();predict();autoStep(c.c);render();\n}\nasync function poll(my){\n  const rows=await yRows(sym,'1d');\n  if(!rows||my!==tok)return;\n  const last=rows[rows.length-1];\n  if(last.t<K[K.length-1].t)return;\n  const closed=rows.slice(0,-1).filter(r=>r.t>K[K.length-1].t);\n  closed.forEach(pushClosed);\n  cur=last;\n  if(closed.length){if(++sinceTrain>=5||!model)train();predict();autoStep(closed[closed.length-1].c)}\n  setStatus();render();\n}\n\nfunction fmt(n){return n>=100?n.toFixed(2):n>=1?n.toFixed(4):n.toFixed(6)}\nfunction live(){\n  if(!cur)return;\n  const up=cur.c>=cur.o;\n  $('px').textContent=fmt(cur.c);$('px').className='price '+(up?'up':'dn');\n  draw();renderPT();\n}\nfunction render(){\n  live();\n  const el=$('call'),why=$('why');\n  if(!model||!pred){el.textContent='Not enough data';el.className='big nu';return}\n  const p=pred.p,edge=Math.abs(p-.5),conf=(Math.max(p,1-p)*100).toFixed(0);\n  $('mt').style.width=(p*100)+'%';\n  if(isClosed()){el.textContent='Market closed';el.className='big nu';why.textContent='Showing the last session. A new call appears when trading resumes.'}\n  else if(stats.acc<=stats.base+.005||edge<.03){\n    el.textContent=edge<.03?'No clear edge':(pred.up?'Lean up ':'Lean down ')+conf+'%';\n    el.className='big nu';\n    why.textContent=stats.acc<=stats.base+.005?'The model is not beating a simple guess on recent candles, so treat this as weak.':'Signals are mixed for the next candle.';\n  }else{\n    el.textContent=(pred.up?'UP ':'DOWN ')+conf+'%';\n    el.className='big '+(pred.up?'up':'dn');\n    why.textContent='Model’s call for the candle now forming, versus the last close.';\n  }\n  $('ind').innerHTML=ind.map(r=>`<div class=\"r\"><span>${r[0]}</span><span class=\"${r[3]>0?'up':r[3]<0?'dn':''}\">${r[1]} · ${r[2]}</span></div>`).join('');\n  $('acc').textContent=(stats.acc*100).toFixed(1)+'% on '+stats.n+' candles';\n  $('base').textContent=(stats.base*100).toFixed(1)+'%';\n  $('cacc').textContent=stats.cAcc==null?'No confident signals':(stats.cAcc*100).toFixed(1)+'% on '+stats.cN+' signals';$('ntr').textContent=stats.total+' candles';\n  const h=hist.filter(x=>x.ok).length;\n  $('live').textContent=hist.length?`${(h/hist.length*100).toFixed(0)}% (${h} of ${hist.length})`:'Waiting for the first candle to close';\n  $('dots').innerHTML=hist.slice().reverse().map(x=>`<b class=\"${x.ok?'ok':''}\" title=\"${x.ok?'Right':'Wrong'}\"></b>`).join('')||'<span style=\"color:var(--mu);font-size:13px\">Green is a correct call, red is a miss. Results appear as candles close.</span>';\n}\nfunction draw(){\n  const cv=$('cv'),d=devicePixelRatio||1,W=cv.clientWidth,H=cv.clientHeight;\n  cv.width=W*d;cv.height=H*d;const g=cv.getContext('2d');g.scale(d,d);\n  const cs=K.slice(-59).concat(cur?[cur]:[]);if(!cs.length)return;\n  const hi=Math.max(...cs.map(x=>x.h)),lo=Math.min(...cs.map(x=>x.l)),pad=(hi-lo)*.08||1,top=hi+pad,bot=lo-pad;\n  const y=v=>8+(top-v)/(top-bot)*(H-16),bw=(W-12)/cs.length;\n  const closes=K.concat(cur?[cur]:[]).map(x=>x.c),e=ema(closes,21).slice(-cs.length);\n  g.strokeStyle='#23393e';g.lineWidth=1;\n  for(let i=1;i<4;i++){g.beginPath();g.moveTo(0,H*i/4);g.lineTo(W,H*i/4);g.stroke()}\n  cs.forEach((x,i)=>{\n    const cx=6+i*bw+bw/2,u=x.c>=x.o;g.strokeStyle=g.fillStyle=u?'#41d9a0':'#ff6f61';\n    g.beginPath();g.moveTo(cx,y(x.h));g.lineTo(cx,y(x.l));g.stroke();\n    g.fillRect(cx-bw*.35,Math.min(y(x.o),y(x.c)),bw*.7,Math.max(1,Math.abs(y(x.o)-y(x.c))));\n  });\n  g.strokeStyle='#f2c14e';g.lineWidth=1.5;g.beginPath();\n  e.forEach((v,i)=>{const cx=6+i*bw+bw/2;i?g.lineTo(cx,y(v)):g.moveTo(cx,y(v))});g.stroke();\n}\nsetInterval(()=>{\n  if(!cur)return;\n  const s=Math.max(0,Math.round((cur.ct-Date.now())/1000));\n  $('cd').textContent=isClosed()?'Closed':'Candle closes in '+Math.floor(s/60)+':'+String(s%60).padStart(2,'0');\n},1000);\n$('sym').onchange=e=>{sym=e.target.value;$('cust').value='';load()};\n$('go').onclick=()=>{const v=$('cust').value.trim();if(v){sym=v;load()}};\n$('iv').onchange=e=>{iv=e.target.value;load()};\naddEventListener('resize',draw);\n/* ---------- licence gate ---------- */\nconst LICENSE_URL='https://raw.githubusercontent.com/shubhworkpvt-cmd/Candle-License/main/licenses.json';\nlet locked=true;\nconst ls=(k,v)=>{try{if(v===undefined)return localStorage.getItem(k);localStorage.setItem(k,v)}catch(e){return null}};\nfunction sha256(s){\n  const b=[...unescape(encodeURIComponent(s))].map(c=>c.charCodeAt(0)),K=[],H=[];\n  const isP=x=>{for(let i=2;i*i<=x;i++)if(x%i===0)return false;return true};\n  for(let n=2,c=0;c<64;n++)if(isP(n)){if(c<8)H.push((Math.pow(n,.5)*4294967296)|0);K.push((Math.pow(n,1/3)*4294967296)|0);c++}\n  const l=b.length*8;b.push(128);while(b.length%64!==56)b.push(0);\n  for(let i=7;i>=0;i--)b.push(i>3?0:(l>>>(i*8))&255);\n  const w=Array(64),h=H.slice();\n  for(let i=0;i<b.length;i+=64){\n    for(let t=0;t<16;t++)w[t]=(b[i+t*4]<<24)|(b[i+t*4+1]<<16)|(b[i+t*4+2]<<8)|b[i+t*4+3];\n    for(let t=16;t<64;t++){const a=w[t-15],c=w[t-2];w[t]=(w[t-16]+((a>>>7|a<<25)^(a>>>18|a<<14)^(a>>>3))+w[t-7]+((c>>>17|c<<15)^(c>>>19|c<<13)^(c>>>10)))|0}\n    let [A,B,C,D,E,F,G,Q]=h;\n    for(let t=0;t<64;t++){\n      const t1=(Q+((E>>>6|E<<26)^(E>>>11|E<<21)^(E>>>25|E<<7))+((E&F)^(~E&G))+K[t]+w[t])|0;\n      const t2=(((A>>>2|A<<30)^(A>>>13|A<<19)^(A>>>22|A<<10))+((A&B)^(A&C)^(B&C)))|0;\n      Q=G;G=F;F=E;E=(D+t1)|0;D=C;C=B;B=A;A=(t1+t2)|0;\n    }\n    [A,B,C,D,E,F,G,Q].forEach((v,j)=>h[j]=(h[j]+v)|0);\n  }\n  return h.map(x=>(x>>>0).toString(16).padStart(8,'0')).join('');\n}\nfunction devId(){\n  let d=ls('cc_dev');\n  if(!d){d='D-';for(let i=0;i<10;i++)d+='ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[Math.floor(Math.random()*32)];ls('cc_dev',d)}\n  return d;\n}\nasync function validate(){\n  const url=LICENSE_URL||ls('cc_url'),key=(ls('cc_key')||'').trim().toUpperCase();\n  if(!url)return{ok:false,msg:'Enter the licence server URL and your key.'};\n  if(!key)return{ok:false,msg:'Enter your access key to continue.'};\n  let db=null,now=Date.now();\n  try{\n    const r=await fetch(url+(url.indexOf('?')>-1?'&':'?')+'t='+Date.now(),{cache:'no-store'});\n    if(r.ok){db=await r.json();const sd=Date.parse(r.headers.get('date'));if(sd)now=sd;ls('cc_cache',JSON.stringify({db:db,at:Date.now()}))}\n  }catch(e){}\n  if(!db){\n    let c=null;try{c=JSON.parse(ls('cc_cache'))}catch(e){}\n    if(c&&Date.now()-c.at<864e5)db=c.db;\n    else return{ok:false,msg:'Cannot verify your licence. Connect to the internet and try again.'};\n  }\n  if(db.app_enabled===false)return{ok:false,msg:db.message||'The service is temporarily unavailable.'};\n  const e=db.keys&&db.keys[sha256(key)];\n  if(!e)return{ok:false,bad:true,msg:'Invalid key.'};\n  if(e.active===false)return{ok:false,msg:'This key has been disabled.'};\n  if(e.expires&&now>Date.parse(e.expires+'T23:59:59Z'))return{ok:false,msg:'This key has expired.'};\n  if(e.device&&e.device!==devId())return{ok:false,msg:'This key is locked to another device.'};\n  return{ok:true,type:e.type||'paid',name:e.name,expires:e.expires,now:now};\n}\nfunction lockUI(msg){\n  tok++;stop();locked=true;\n  $('app').style.display='none';$('lock').style.display='block';\n  $('lmsg').textContent=msg||'';$('lurl').style.display=LICENSE_URL?'none':'block';$('dev').textContent=devId();\n}\nfunction unlockUI(L){\n  const days=L.expires?Math.max(0,Math.ceil((Date.parse(L.expires+'T23:59:59Z')-L.now)/864e5)):null;\n  $('lic').textContent=(L.type==='demo'?'DEMO':'PRO')+(L.name?' · '+L.name:'')+(days!==null?' · '+days+' day'+(days===1?'':'s')+' left':'');\n  $('lock').style.display='none';$('app').style.display='block';\n  if(locked){locked=false;load()}\n}\nasync function check(){\n  const L=await validate();\n  if(L.ok)unlockUI(L);\n  else{if(L.bad)try{localStorage.removeItem('cc_key')}catch(e){}lockUI(L.msg)}\n}\n$('act').onclick=async()=>{\n  const u=$('lurl').value.trim(),k=$('lkey').value.trim().toUpperCase();\n  if(!LICENSE_URL&&u)ls('cc_url',u);\n  if(k)ls('cc_key',k);\n  $('lmsg').textContent='Checking…';await check();\n};\n/* ---------- demo trading ---------- */\nlet acct={bal:10000,pos:{},hist:[],auto:false,pct:25};\ntry{const a=JSON.parse(ls('cc_acct'));if(a&&a.bal!=null)acct=a}catch(e){}\nconst START=10000,FEE=.0005,saveA=()=>ls('cc_acct',JSON.stringify(acct));\nfunction openPos(side,auto){\n  if(!cur||isClosed()||acct.pos[sym])return;\n  const used=Object.values(acct.pos).reduce((a,p)=>a+p.n,0),n=Math.min(acct.bal*acct.pct/100,acct.bal-used);\n  if(n<1)return;\n  acct.bal-=n*FEE;acct.pos[sym]={side:side,e:cur.c,q:n/cur.c,n:n,auto:!!auto,fee:n*FEE};saveA();renderPT();\n}\nfunction closePos(price){\n  const p=acct.pos[sym];if(!p)return;\n  const gross=(p.side==='long'?price-p.e:p.e-price)*p.q,fee=p.n*FEE;\n  acct.bal+=gross-fee;\n  acct.hist.unshift({s:sym,side:p.side,e:p.e,x:price,pnl:gross-fee-p.fee,auto:p.auto});\n  if(acct.hist.length>200)acct.hist.pop();\n  delete acct.pos[sym];saveA();renderPT();\n}\nfunction autoStep(price){\n  if(!acct.auto)return;\n  if(acct.pos[sym]&&acct.pos[sym].auto)closePos(price);\n  if(pred&&model&&!isClosed()&&!acct.pos[sym]&&Math.abs(pred.p-.5)>=.04)openPos(pred.up?'long':'short',true);\n}\nfunction renderPT(){\n  const p=acct.pos[sym],u=p&&cur?(p.side==='long'?cur.c-p.e:p.e-cur.c)*p.q:0,eq=acct.bal+u;\n  $('ptEq').textContent=eq.toFixed(2)+' ('+(eq>=START?'+':'')+(eq-START).toFixed(2)+')';$('ptEq').className=eq>=START?'up':'dn';\n  const others=Object.keys(acct.pos).filter(k=>k!==sym);\n  $('ptPos').textContent=(p?p.side.toUpperCase()+' @ '+fmt(p.e)+' · '+(u>=0?'+':'')+u.toFixed(2)+(p.auto?' (auto)':''):'None')+(others.length?' · also open: '+others.join(', '):'');\n  const off=!cur||isClosed();['bBuy','bSell','bClose'].forEach(i=>$(i).disabled=off);\n  const n=acct.hist.length,w=acct.hist.filter(h=>h.pnl>0).length,t=acct.hist.reduce((a,h)=>a+h.pnl,0);\n  $('ptStat').textContent=n?n+' · '+Math.round(w/n*100)+'% · '+(t>=0?'+':'')+t.toFixed(2):'No trades yet';\n  $('ptHist').innerHTML=acct.hist.slice(0,6).map(h=>'<div class=\"r\"><span>'+(NAMES[h.s]||h.s)+' '+h.side+(h.auto?' (auto)':'')+'</span><span class=\"'+(h.pnl>=0?'up':'dn')+'\">'+(h.pnl>=0?'+':'')+h.pnl.toFixed(2)+'</span></div>').join('');\n}\n$('ptPct').value=acct.pct;$('ptAuto').checked=!!acct.auto;\n$('ptPct').onchange=e=>{acct.pct=+e.target.value;saveA()};\n$('ptAuto').onchange=e=>{acct.auto=e.target.checked;saveA()};\n$('bBuy').onclick=()=>{const p=acct.pos[sym];if(!p)openPos('long');else if(p.side==='short')closePos(cur.c)};\n$('bSell').onclick=()=>{const p=acct.pos[sym];if(!p)openPos('short');else if(p.side==='long')closePos(cur.c)};\n$('bClose').onclick=()=>{if(acct.pos[sym])closePos(cur.c)};\n$('ptReset').onclick=()=>{if(confirm('Reset the demo account to 10,000 and clear all trades?')){acct={bal:START,pos:{},hist:[],auto:false,pct:25};$('ptAuto').checked=false;$('ptPct').value=25;saveA();renderPT()}};\n\n/* ---------- in-app updates ---------- */\nconst UPD_PUB={\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"3WNRw6Jqzzq1xGZVWStWNdGnSyKTDCzCvnB5pHuSh_E\",\"y\":\"VfFkzd-nOxINl4HD2PaWy24IgosmK8kHBJUDDDlcRx8\"};\nlet updState='Checking for updates…';\nfunction b64(s){const b=atob(s),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u}\nfunction showUpd(t,label,fn){$('updt').textContent=t;$('updb').textContent=label;$('updb').onclick=fn;$('upd').style.display='block'}\nfunction showVer(){$('ver').textContent='App v'+APP_VER+' · build '+NATIVE_VER+' · '+updState}\nasync function checkUpdate(){\n  try{\n    if(!LICENSE_URL){updState='Updates off (no server)';return}\n    if(typeof crypto==='undefined'||!crypto.subtle){updState='Updates unavailable on this device';return}\n    const r=await fetch(LICENSE_URL.replace('licenses.json','update.json')+'?t='+Date.now(),{cache:'no-store'});\n    if(!r.ok){updState='Up to date';return}\n    const u=await r.json(),cv=Math.max(APP_VER,+ls('cc_ver')||0);\n    const msg=[u.version,sha256(u.html||''),u.apk_version||0,u.apk||''].join('\\n');\n    const key=await crypto.subtle.importKey('jwk',UPD_PUB,{name:'ECDSA',namedCurve:'P-256'},false,['verify']);\n    if(!await crypto.subtle.verify({name:'ECDSA',hash:'SHA-256'},key,b64(u.sig),new TextEncoder().encode(